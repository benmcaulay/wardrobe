# ------------------------------------------------------------
# Phase 1 (foundation) — the only var actually needed today.
# ------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------
# Phase 2 — real external APIs. Not required yet; stubs in
# lib/services/* are used when these are unset.
# Set USE_REAL_* to "true" to switch an individual service on.
# ------------------------------------------------------------

# --- Vision / garment tagging (lib/services/vision.ts)
# Suggested providers: Anthropic Claude Vision, OpenAI Vision, Google Vision AI.
USE_REAL_VISION="false"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Web product search (add item + reverse image)
# SerpAPI Google Shopping (text search) + Google Lens (photo match on upload).
# Set USE_REAL_REVERSE_IMAGE_SEARCH=true and SERPAPI_KEY. For Lens, also set:
#   PUBLIC_APP_URL=https://your-deployed-app.example  (HTTPS, reachable by SerpAPI)
#   PUBLIC_IMAGE_SECRET=long-random-string
# Auto-fill add-item fields from the top photo match (and stub matches in dev). Off by default.
ENABLE_WEB_MATCH_AUTOFILL="false"
USE_REAL_REVERSE_IMAGE_SEARCH="false"
SERPAPI_KEY=""
PUBLIC_APP_URL=""
PUBLIC_IMAGE_SECRET=""
BING_VISUAL_SEARCH_KEY=""

# --- Product scraper (lib/services/productScraper.ts)
# Suggested providers: ScrapingBee, Bright Data, Apify, or a custom fetcher.
USE_REAL_PRODUCT_SCRAPER="false"
SCRAPINGBEE_API_KEY=""

# --- Ghost mannequin (lib/services/ghostMannequin.ts)
# Real provider: fal.ai (default model: gemini-25-flash-image/edit, ~$0.04/call).
# Other tested model paths:
#   FAL_GHOST_MODEL="fal-ai/flux-pro/kontext"           # Flux Kontext, ~$0.04
#   FAL_GHOST_MODEL="fal-ai/flux-pro/kontext/max/multi" # Flux Kontext Max
#   FAL_GHOST_MODEL="fal-ai/seedream/v4/edit"           # SeedDream
# When USE_REAL_GHOST_MANNEQUIN=false: stub renders a paper-grey backdrop with
# a watermark, and credits are NOT decremented (so the demo never runs out).
# When true: real fal.ai call + atomic credit decrement on success.
USE_REAL_GHOST_MANNEQUIN="false"
FAL_KEY=""
FAL_GHOST_MODEL=""

# --- Virtual try-on (lib/services/virtualTryOn.ts)
# Real mode: set USE_REAL_VIRTUAL_TRYON="true", then either:
#   • FASHN_API_KEY — default model tryon-v1.6 is best for tops/bottoms/dresses;
#     it does NOT model hats/shoes well (category is only tops|bottoms|one-pieces|auto).
#     For hats, bags, jewelry, shoes use: FASHN_TRYON_MODEL="tryon-max"
#     (uses product_image + model_image, 2–5 credits per image; optional FASHN_TRYON_RESOLUTION=1k|2k|4k).
#   • FAL_KEY (+ optional FAL_VTON_MODEL) — fal.ai multi-image edit; costs 1
#     in-app credit per successful generation.
# If both FASHN_API_KEY and FAL_KEY are set, Fashn is preferred.
# Stub mode composites a watermarked preview when USE_REAL_VIRTUAL_TRYON is not "true".
USE_REAL_VIRTUAL_TRYON="false"
FASHN_API_KEY=""
FASHN_TRYON_MODEL=""
FASHN_TRYON_RESOLUTION=""
FAL_VTON_MODEL=""

# --- Background removal (lib/services/backgroundRemoval.ts)
# Real removal happens client-side via @imgly/background-removal (free, WASM).
# These vars are only for a server-side fallback if the client lib stops working.
USE_REAL_BACKGROUND_REMOVAL="false"
REMOVE_BG_API_KEY=""
PHOTOROOM_API_KEY=""

# --- Trip climate (lib/services/weather.ts) — SmartPakker
# Real provider is Open-Meteo (free, no API key needed). Set USE_REAL_WEATHER
# to "true" to resolve the destination and pull a real forecast (within ~16
# days). When off, a deterministic latitude/month climatology stub is used so
# the feature works fully offline.
USE_REAL_WEATHER="false"

# ------------------------------------------------------------
# Auth (future — today we use a demo-user cookie)
# ------------------------------------------------------------
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
