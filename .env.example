# ------------------------------------------------------------
# Phase 1 (foundation) — the only var actually needed today.
# Local dev: `docker compose up -d db` starts a matching Postgres 16.
# ------------------------------------------------------------
DATABASE_URL="postgresql://wardrobe:wardrobe@localhost:5432/wardrobe"
# Direct (non-pooled) connection, used only for migrations. On a hosted Postgres
# behind a pooler this is the port-5432 URL; locally it is the same as above.
DIRECT_DATABASE_URL="postgresql://wardrobe:wardrobe@localhost:5432/wardrobe"

# ------------------------------------------------------------
# File storage. Default driver is "local" (files under ./uploads, served by the
# image routes). Set STORAGE_DRIVER="s3" — auto-selected when S3_BUCKET is set —
# for Supabase Storage, Cloudflare R2, AWS S3, or MinIO. The image routes then
# redirect to short-lived signed URLs instead of streaming bytes.
#
# Supabase (see docs/CLOUD_MIGRATION.md):
#   S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
#   S3_REGION="<project region, e.g. us-east-1>"   # Supabase needs a real region
#   S3_FORCE_PATH_STYLE="true"                     # required
#   credentials come from Storage -> S3 Access Keys, NOT the anon/service key
#
# Cloudflare R2:
#   S3_ACCOUNT_ID -> derives https://<id>.r2.cloudflarestorage.com
#   S3_REGION="auto" is fine, path style not needed
#
# S3_PUBLIC_BASE_URL is an optional CDN/public-bucket base that skips signing.
# The older R2_* spelling of every name below still works as a fallback.
# Verify either spelling locally with: pnpm test:s3
# ------------------------------------------------------------
# Automatic backdrop whiten when a new upload is saved to the closet.
# Tolerance is the per-channel distance from the sampled corner colour, on the
# same 0-120 scale as the manual Whiten tool. 1 only catches pixels identical to
# the backdrop: complete on flat product-shot backdrops, near a no-op on noisy
# camera photos. Raise it (the manual tool defaults to 36) if backdrops survive.
AUTO_WHITEN_ON_SAVE=""
AUTO_WHITEN_TOLERANCE=""

STORAGE_DRIVER=""
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""
S3_PUBLIC_BASE_URL=""
# R2 only: derives the endpoint from your Cloudflare account id.
S3_ACCOUNT_ID=""

# ------------------------------------------------------------
# Observability & AI cost guardrails.
# SENTRY_DSN enables server-side error reporting (inert when unset).
# Quotas count today's logged generations (UTC); defaults are generous so
# dev never notices — tighten in production:
#   AI_DAILY_LIMIT_PER_USER (default 200)   AI_DAILY_LIMIT_GLOBAL (default 1000)
#   AI_GENERATIONS_DISABLED="true"  -> emergency kill switch for all generation
# ------------------------------------------------------------
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""

# ------------------------------------------------------------
# Payments — Stripe Checkout for credit packs (lib/credit-packs.ts).
# Inert (and the Buy buttons hidden) unless STRIPE_SECRET_KEY is set.
# Fulfillment happens via the webhook: point a Stripe webhook at
#   <origin>/api/stripe/webhook   (event: checkout.session.completed)
# and set STRIPE_WEBHOOK_SECRET to its signing secret. Checkout redirect
# URLs use NEXT_PUBLIC_APP_URL (falls back to NEXTAUTH_URL).
# Verify locally with: pnpm test:stripe
# ------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL=""
# Background generation worker (run `pnpm worker` alongside the web server).
WORKER_POLL_MS="2000"
AI_DAILY_LIMIT_PER_USER=""
AI_DAILY_LIMIT_GLOBAL=""
AI_GENERATIONS_DISABLED=""

# ------------------------------------------------------------
# Phase 2 — real external APIs. Not required yet; stubs in
# lib/services/* are used when these are unset.
# Set USE_REAL_* to "true" to switch an individual service on.
# ------------------------------------------------------------

# --- Vision / garment tagging (lib/services/vision.ts)
# Suggested providers: Anthropic Claude Vision, OpenAI Vision, Google Vision AI.

# --- Product lookup (SerpAPI) — the one non-gemini service still wired in.
# Gemini has no web access: it can name a garment but not price or link it, and
# an invented price silently corrupts the wishlist budget at /closet/wishlist.
#
# SERPAPI_KEY alone enables the text lane (Google Shopping). It needs nothing
# public and works from localhost.
#
# Google Lens (photo match on upload) additionally needs SerpAPI to FETCH the
# image, so it requires a public HTTPS origin and never fires on localhost:
#   PUBLIC_APP_URL=https://your-deployed-app.example
#   PUBLIC_IMAGE_SECRET=long-random-string
# Without those, an upload falls back to gemini identification: name and brand,
# no price, no URL.
#
# Auto-fill add-item fields from the top photo match. Off by default.
ENABLE_WEB_MATCH_AUTOFILL="false"
SERPAPI_KEY=""
PUBLIC_APP_URL=""
PUBLIC_IMAGE_SECRET=""

# What one SerpAPI search costs you, in TENTHS of a US cent (so $0.015 = 15).
#
# SerpAPI bills per search *request*, not per result — one search returns forty
# to sixty products and all of them are free to scroll. The number that matters
# is therefore how many searches you issue, and the biggest source is "Check
# prices" on the wishlist, which searches once per watched item whose store page
# has no readable price.
#
# Left empty on purpose: the per-search price depends on your plan, and this app
# does not print guessed figures. Empty means Settings shows a search *count*
# with no dollar total. Set it to your plan's rate — $75/5,000 searches is 15 —
# and the total appears alongside generation spend.
SERPAPI_COST_TENTH_CENTS=""

# --- Product scraper (lib/services/productScraper.ts)
# Real mode fetches the product page directly and reads schema.org/Product
# JSON-LD + OpenGraph tags (lib/services/pdp-parse.ts). No API key needed.
# Leave "false" only for offline dev — the stub fabricates prices, which makes
# the wishlist budget at /closet/wishlist meaningless.
# For retailers that block plain fetches, front this with ScrapingBee/Bright Data.
USE_REAL_PRODUCT_SCRAPER="true"

# --- Ghost mannequin (lib/services/ghostMannequin.ts)
# Real provider: fal.ai (default model: seedream/v4/edit, ~$0.03/call).
# Other tested model paths:
#   FAL_GHOST_MODEL="fal-ai/flux-pro/kontext"           # Flux Kontext, ~$0.04
#   FAL_GHOST_MODEL="fal-ai/flux-pro/kontext/max/multi" # Flux Kontext Max
#   FAL_GHOST_MODEL="fal-ai/seedream/v4/edit"           # SeedDream
# When USE_REAL_GHOST_MANNEQUIN=false: stub renders a paper-grey backdrop with
# a watermark, and credits are NOT decremented (so the demo never runs out).
# When true: real fal.ai call + atomic credit decrement on success.
USE_REAL_GHOST_MANNEQUIN="false"
FAL_KEY=""
# Default model is now fal-ai/seedream/v4/edit (top-tier prompt adherence so it
# actually obeys the camera-angle requirements; ~$0.04/call).
FAL_GHOST_MODEL=""
# Which vendor runs the edit: "gemini" (default) or "fal".
#   gemini uses the Interactions API (POST /v1beta/interactions).
#   Key from Google AI Studio: https://aistudio.google.com/apikey
#   NOT free: Google lists Free Tier "Not available" for every image model and the
#   API returns limit:0 on the free-tier metric. BILLING MUST BE ENABLED on the
#   Google project or every generation fails with HTTP 429.
# Leaving this blank means: gemini when GEMINI_API_KEY is set, otherwise fal — so
# an environment with only a fal key still works. Set "fal" to force fal.
# A trained LoRA only applies on fal, so setting FAL_GHOST_LORA_URL forces
# provider back to fal rather than silently dropping the LoRA.
GHOST_PROVIDER=""
GEMINI_API_KEY=""
# Default gemini-3.1-flash-image (Nano Banana 2, $0.067/1K). Cheapest is
# gemini-2.5-flash-image (flat $0.039); best quality gemini-3-pro-image
# ($0.134/1K). fal Seedream v4 edit is ~$0.03 for comparison.
GEMINI_IMAGE_MODEL=""
# Trained ghost-mannequin edit LoRA (scripts/ghost-lora-train.ts prints the url).
# When set, generation routes to fal-ai/flux-2/lora/edit with the LoRA applied.
# Deterministic exposure correction (lib/services/normalize-exposure.ts).
# On by default: measures garment luma + clipping and applies a gamma curve and
# a foreground-only highlight shoulder. Set "false" to keep the model's output.
GHOST_EXPOSURE_NORMALIZE=""
# Offline prompt bakeoff (scripts/ghost-bakeoff.ts):
#   pnpm ghost:bakeoff -- --fixtures=./fixtures/ghost --config=./scripts/ghost-bakeoff.variants.example.json
# Camera angles baked into the ghost prompt (override to restyle the catalog):
#   GHOST_FOOTWEAR_ANGLE default: both shoes ~45° to the viewer's left, matched pair
#   GHOST_APPAREL_ANGLE  default: facing straight forward, squared to the camera
# Footwear pose. The prompt states the target positively — a wall of "never"
# clauses measurably did not work, and naming "mirrored" repeatedly may anchor it.
GHOST_FOOTWEAR_ANGLE=""
# Footwear runs on the pro image model when it runs on gemini: measured, flash
# renders the pair mirrored sole-to-sole and pro gets the direction right. Twice
# the price ($0.134 vs $0.067) on the one category where pose is least forgiving.
# An explicit GEMINI_IMAGE_MODEL overrides this for every category.
GEMINI_FOOTWEAR_MODEL=""
# Optional storage key of an image whose *arrangement* footwear renders should
# copy — few-shot for pose, for when words are not landing. Point it at a good
# render of your own. Off by default; the positive prompt plus the pro model
# already produce a correct pair. Included in the render cache key.
GHOST_FOOTWEAR_POSE_REFERENCE=""
# Catalog post-process after fal (bakeoff: prod-raw / none won).
#   none   — resize only for catalog JPEG; still builds a transparent cutout
#   whiten — pure-white backdrop on catalog + cutout
#   full   — whiten + neck-post removal + center + shadow soften (+ optional fal repair)
GHOST_POST_PROCESS="none"
# fal second-pass neck repair (only used when GHOST_POST_PROCESS=full). Default on.
GHOST_NECK_FAL_REPAIR=""
# Background-whitening tuning (used for cutout always; for catalog when whiten|full).
# Raise *_MIN values toward 255 if white garment edges get eaten; lower them if a
# gray halo/fringe survives. HALO_* snaps the near-white fringe around the garment
# to white in the catalog image (set GHOST_WHITEN_HALO_PASSES=0 to disable).
GHOST_WHITEN_SEED_MIN=""
GHOST_WHITEN_EXPAND_MIN=""
GHOST_WHITEN_LEGACY_MIN=""
GHOST_WHITEN_ERODE_PASSES=""
GHOST_WHITEN_HALO_MIN=""
GHOST_WHITEN_HALO_PASSES=""
# Shadow recovery on ghost catalog images (full mode only; 0 disables).
GHOST_SHADOW_LIFT=""
GHOST_SHADOW_FLOOR=""
GHOST_BLACK_PRESERVE=""

# --- Camera roll scan (lib/services/garmentClassifier.ts)
# Vision model filters non-garment photos before ghost generation. Set to "false"
# to accept every photo in dev (stub classifier).
USE_REAL_GARMENT_CLASSIFIER="true"
# Bounding-box crop for multi-item camera-roll photos (Moondream object detection)

# --- Virtual try-on (lib/services/virtualTryOn.ts)
# Real mode: set USE_REAL_VIRTUAL_TRYON="true", then either:
#   • FASHN_API_KEY — default model tryon-v1.6 is best for tops/bottoms/dresses;
#     it does NOT model hats/shoes well (category is only tops|bottoms|one-pieces|auto).
#     For hats, bags, jewelry, shoes use: FASHN_TRYON_MODEL="tryon-max"
#     (uses product_image + model_image, 2–5 credits per image; optional FASHN_TRYON_RESOLUTION=1k|2k|4k).
#   • FAL_KEY — fal.ai try-on; costs 1 in-app credit per successful generation.
#     Default model is now fal-ai/idm-vton, a DEDICATED person try-on model
#     (preserves identity/pose, maps garments to the right body region). Multi-
#     garment outfits are chained one garment at a time. Override FAL_VTON_MODEL
#     with an editor (fal-ai/gemini-25-flash-image/edit, fal-ai/flux-pro/kontext,
#     fal-ai/seedream/v4/edit) to use the older single-call multi-image-edit path.
#     Optional FAL_VTON_STEPS raises idm-vton inference steps (sharper, slower).
# If both FASHN_API_KEY and FAL_KEY are set, Fashn is preferred.
# Stub mode composites a watermarked preview when USE_REAL_VIRTUAL_TRYON is not "true".
USE_REAL_VIRTUAL_TRYON="false"
# tryon-v1.6 quality knobs (ignored by tryon-max):
#   FASHN_TRYON_MODE: performance | balanced | quality  (default: quality — best fidelity)
#   FASHN_GARMENT_PHOTO_TYPE: auto | model | flat-lay    (default: flat-lay — our garment
#     refs are product/ghost cutouts; set "auto" if you feed on-model garment photos)
# fal try-on (used when FASHN_API_KEY is unset). Default model: fal-ai/idm-vton.

# --- Background removal (lib/services/backgroundRemoval.ts)
# Real removal happens client-side via @imgly/background-removal (free, WASM).
# These vars are only for a server-side fallback if the client lib stops working.

# --- Trip climate (lib/services/weather.ts) — SmartPakker
# Real provider is Open-Meteo (free, no API key needed). Set USE_REAL_WEATHER
# to "true" to geocode the destination and pull real numbers: the forecast
# endpoint for dates within its window (92 days back to 16 days out) and the
# ERA5 archive for anything outside it — observed weather for a trip that has
# already happened, or the same calendar dates averaged over the last 5 years
# for one booked further out. A trip straddling the horizon gets both, weighted
# by the days each covers.
#
# When off there is no geocoding, so there are no coordinates, so there is
# nothing honest to say about the destination's weather: trips report their
# climate as "unknown" and SmartPakker asks the user to pick a rough band
# instead. (It used to hash the destination name into a fake latitude and run it
# through a cosine seasonal model, which produced confident nonsense — Ireland
# in June came out "Hot, 28°C" — and silently drove the whole packing plan.)
# Turning this on is free and keyless; recommended.
USE_REAL_WEATHER="true"

# --- Trip description parsing (lib/services/tripParser.ts) — SmartPakker
# Turns "5 days in Lisbon for a wedding, plus a beach day" into structured trip
# requirements. Needs ANTHROPIC_API_KEY. When off (or on any failure) a keyword
# matcher handles it instead, so the feature works with no key — the AI only
# improves the long tail.
#
# It is deliberately a *parser*, not a planner: it fills the same structure the
# activity chips fill, and the deterministic packer still decides what goes in
# the bag. Never let a model near the volume/weight optimisation.
# (ANTHROPIC_API_KEY is declared once above, under Vision.)
USE_REAL_TRIP_PARSER="false"

# ------------------------------------------------------------
# Auth — NextAuth with Google OAuth (database sessions in Postgres).
# Real sign-in: register an OAuth app at console.cloud.google.com
# (authorized redirect URI: <origin>/api/auth/callback/google) and set:
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   NEXTAUTH_SECRET  — required in production; generate: openssl rand -base64 32
#   NEXTAUTH_URL     — the deployed origin (http://localhost:3000 in dev)
# Keyless local dev/demo: set AUTH_DEMO_MODE="true" to enable the single
# shared demo user behind a plain cookie. Development only — demoModeEnabled()
# returns false under NODE_ENV=production whatever this is set to, because the
# cookie is not a credential and the account is shared. There is deliberately
# no override; a demo real people can reach needs an account per visitor.
# ------------------------------------------------------------
AUTH_DEMO_MODE="true"
NEXTAUTH_SECRET=""

# Vercel Cron drains the job queue by calling /api/cron/drain, authenticated
# with this as a bearer token. The route refuses to run (503) without it,
# because draining spends Gemini credits. Generate: openssl rand -base64 32
CRON_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
