generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE on JSON columns:
// Structured fields (colors, styleTags, season, stylePrefs, sourceData) are
// stored as JSON-encoded strings (TEXT), a holdover from the original SQLite
// datasource. Use the helpers in lib/json.ts to read/write them so the
// encoding stays consistent. Converting them to native `Json` columns is a
// planned follow-up: it changes encode()'s contract at every write site, so
// it gets its own migration + PR rather than riding along with the engine
// switch.

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  emailVerified     DateTime? // NextAuth adapter field
  image             String? // NextAuth adapter field (avatar URL)
  stylePrefs        String? // JSON: { sizes?, favoriteColors?: string[], styles?: string[] }
  credits           Int                @default(0) // ghost-mannequin generations
  autoGenerateGhost Boolean            @default(false)
  createdAt         DateTime           @default(now())
  items             WardrobeItem[]
  tryOns            TryOnGeneration[]
  personPhotos      PersonPhoto[]
  outfits           Outfit[]
  outfitLayouts     OutfitLayout[]
  virtualTryOns     VirtualTryOn[]
  saleListings      SaleListing[]
  listingPlacements ListingPlacement[]
  packingBags       PackingBag[]
  packingTrips      PackingTrip[]
  packingGear       PackingGear[]
  accounts          Account[]
  sessions          Session[]
  generationJobs    GenerationJob[]
  creditPurchases   CreditPurchase[]
  budgets           Budget[]
  shareLinks        ShareLink[]
  wearEvents        WearEvent[]
  preferenceEvents  PreferenceEvent[]
  styleNotes        StyleNote[]
}

// An unlisted public link to one item, one outfit, or the wishlist.
//
// The token is the only credential, so it must be long and random — see
// lib/share/token.ts. Links never expire but can be revoked at any time;
// `revokedAt` is kept rather than deleting the row so a revoked URL keeps
// resolving to a clear "this link was turned off" page instead of a 404 that
// looks like a bug.
//
// Only ever exposes derived data: the *thumbnail* of an item (never the
// full-resolution original) plus name, brand and colours.
model ShareLink {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  /// "item" | "outfit" | "wishlist" — see lib/share/kinds.ts
  kind      String
  /// WardrobeItem or Outfit id. Null for the wishlist, which is per-user.
  targetId  String?
  /// Optional note shown on the public page, e.g. "my birthday list".
  note      String?
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, kind])
}

// A pot of money earmarked for wishlist buying (e.g. "Grandma fund"). Wishlist
// items attach to a budget; purchased ones draw it down. When fundedBySales is
// on, proceeds from SaleListings marked sold top the pot back up, so clearing
// out the closet visibly grows the number you have to spend.
model Budget {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  amountCents   Int
  currency      String         @default("USD")
  fundedBySales Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         WardrobeItem[]

  @@index([userId])
}

// A completed Stripe Checkout purchase of a credit pack. The unique
// stripeSessionId makes webhook delivery idempotent: replays hit the
// constraint and are ignored instead of double-granting credits.
model CreditPurchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId String   @unique
  packId          String
  credits         Int
  amountCents     Int
  currency        String   @default("usd")
  createdAt       DateTime @default(now())

  @@index([userId])
}

// Background generation job. Generation (esp. multi-garment virtual try-on,
// which chains one provider call per garment) is too slow to run inside a
// request on serverless hosts, so it's queued here and executed by a worker
// (scripts/worker.ts). The UI enqueues, then polls status.
//   type:   "virtual_tryon" (more later)
//   status: "queued" | "running" | "succeeded" | "failed"
//   payload/result: JSON-encoded (see lib/jobs/*)
model GenerationJob {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  status      String    @default("queued")
  payload     String
  result      String?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

// --- NextAuth (Auth.js) adapter models -------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WardrobeItem {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  brand             String?
  category          String
  subcategory       String?
  colors            String // JSON: { hex, name }[]
  priceCents        Int?
  currency          String            @default("USD")
  retailer          String?
  productUrl        String?
  material          String?
  pattern           String?
  styleTags         String // JSON: string[]
  season            String // JSON: string[]
  owners            String            @default("[]") // JSON: string[] of owner ids (see stylePrefs.owners roster)
  dHash             String? // perceptual hash of the garment image (duplicate detection); computed lazily
  originalImagePath String
  originalThumbZoom Float             @default(1) // zoom applied when framing the original in square tiles
  originalMirror    Boolean           @default(false)
  ghostImagePath    String?
  ghostViews        String? // JSON: { label: string; imagePath: string }[]
  extraImagePaths   String? // JSON: string[] — extra context shots
  isWishlist        Boolean           @default(false)
  // Wishlist budgeting. `budgetId` is the pot this item draws from;
  // `wishlistPriority` is 0 = must have, 1 = want, 2 = someday (see
  // lib/wishlist/priority.ts). Once bought, isWishlist flips false and
  // purchasedAt/purchasedCents record the actual draw-down — priceCents stays
  // the retail sticker so cost tracking and resale estimates still anchor to it.
  budgetId          String?
  budget            Budget?           @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  wishlistPriority  Int               @default(1)
  purchasedAt       DateTime?
  purchasedCents    Int?
  priceHistory      String? // JSON: { cents: number; at: string }[] — oldest first
  priceCheckedAt    DateTime?
  // Wear history. `timesWorn` and `lastWornAt` predate WearEvent and are now
  // denormalized mirrors of it — recomputed by lib/wear/rollup.ts, never
  // incremented directly. `timesWorn` stays the *integer count of confident
  // wears* so user-facing copy ("worn 4 times") remains literally true;
  // `effectiveWears` is the confidence-weighted sum that models should read,
  // since a photo-inferred wear is evidence, not a fact.
  timesWorn         Int               @default(0)
  effectiveWears    Float             @default(0)
  lastWornAt        DateTime?
  // Set when the user marks an item exempt from dormancy surfacing. No UI yet
  // (see docs/OUTFIT_INTELLIGENCE.md "Settled scope") — the field ships early
  // because the scoring suppression rules and the protect-rate guardrail both
  // read it, and retrofitting it later would mean a migration mid-feature.
  protectedAt       DateTime?
  // Packing estimates (SmartPakker). Null = derive from the heuristic table in
  // lib/packing/estimate.ts; populated = manual or (future) AI override.
  weightGrams       Int?
  volumeLiters      Float?
  /// Whether this belongs in the day-to-day rotation. Null = work it out from
  /// the name (lib/packing/occasion.ts); true/false is the user overriding that
  /// guess. Swim trunks classify as an ordinary `bottom`, so without this the
  /// day planner schedules them for a Wednesday in Seoul and counts them toward
  /// the trip's coverage.
  dailyWear         Boolean?
  notes             String?
  sourceData        String? // JSON: raw stub/API response for debugging
  createdAt         DateTime          @default(now())
  tryOns            TryOnGeneration[]
  saleListing       SaleListing?
  embedding         ItemEmbedding?
  wearEvents        WearEventItem[]

  @@index([userId])
  @@index([userId, category])
  @@index([userId, isWishlist])
  @@index([budgetId])
}

model TryOnGeneration {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  item            WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  resultImagePath String
  creditsUsed     Int          @default(1)
  createdAt       DateTime     @default(now())

  @@index([userId])
  @@index([itemId])
}

// A reference photo of the user (face / body) used as the subject for
// virtual try-on. Up to ~5 are kept active at a time but the model itself
// imposes no hard cap; the UI does.
model PersonPhoto {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  imagePath     String
  label         String?
  createdAt     DateTime       @default(now())
  virtualTryOns VirtualTryOn[]

  @@index([userId])
}

// A saved combination of WardrobeItem ids the user can try on as a unit.
model Outfit {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  itemIds       String // JSON: string[] of WardrobeItem ids
  createdAt     DateTime       @default(now())
  virtualTryOns VirtualTryOn[]

  @@index([userId])
}

// One virtual try-on generation: a person photo + a set of garment items
// (optionally a saved Outfit) → a generated image.
model VirtualTryOn {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  personPhotoId   String
  personPhoto     PersonPhoto @relation(fields: [personPhotoId], references: [id], onDelete: Cascade)
  outfitId        String?
  outfit          Outfit?     @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  itemIds         String // JSON: string[] of WardrobeItem ids
  prompt          String?
  resultImagePath String
  creditsUsed     Int         @default(1)
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([personPhotoId])
}

// Result of triaging a wardrobe item in the swipe-to-sell deck. One row per
// item the user has made a decision on. Marketplaces don't expose public
// listing APIs, so this tracks intent + a generated draft the user copies into
// Depop/Poshmark/etc. manually.
//   status: "skipped" (keep) | "for_sale" | "listed" | "sold"
model SaleListing {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId         String             @unique
  item           WardrobeItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status         String             @default("for_sale")
  askingCents    Int?
  soldPriceCents Int? // actual sale proceeds, recorded when marked sold
  currency       String             @default("USD")
  condition      String? // "new_with_tags" | "like_new" | "good" | "fair"
  title          String?
  description    String?
  marketplaces   String             @default("[]") // JSON: string[] of marketplace ids
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  placements     ListingPlacement[]

  @@index([userId])
  @@index([userId, status])
}

// One row per (listing × marketplace): where a piece was actually cross-posted,
// and — if it sold there — for how much, minus what the platform took.
//
// SaleListing stays the item-level draft (title, description, asking price);
// placements hold the per-platform truth, so the same coat can sit live on Depop
// and Poshmark at once and sell on exactly one of them. Every per-platform and
// time-to-sell number on the Sell landing reads off this table.
//
// `SaleListing.marketplaces` predates this and only ever recorded *intent* —
// which platforms the user meant to post to. It's kept in sync as a denormalized
// mirror so older screens keep working; placements are the source of truth.
model ListingPlacement {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId      String
  listing        SaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Marketplace id from lib/marketplaces.ts ("depop" | "poshmark" | …).
  platform       String
  /// "draft" | "listed" | "sold" | "ended" — see lib/sell/placement.ts
  status         String      @default("draft")
  /// Asking price on THIS platform; null means "same as the listing's".
  askingCents    Int?
  soldPriceCents Int?
  /// Commission the platform took. Recorded when known, estimated otherwise —
  /// `feeEstimated` says which, so we never present a guess as a fact.
  feeCents       Int?
  feeEstimated   Boolean     @default(true)
  /// Shipping the seller absorbed, when they did.
  shippingCents  Int?
  currency       String      @default("USD")
  /// When it actually went live / sold here. These drive time-to-sell; the
  /// row's updatedAt can't, since any edit moves it.
  listedAt       DateTime?
  soldAt         DateTime?
  /// Deep link to the live listing, when the user pastes one.
  externalUrl    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([listingId, platform])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, platform, status])
  @@index([userId, soldAt])
}

// Saved drag/resize/layer outfit compositions for the outfit-builder canvas.
model OutfitLayout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  frameHeight Int
  pieces      String // JSON: { id, itemId, x, y, scale, z }[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// A piece of luggage the user owns (SmartPakker). `silhouette` is a preset id
// from lib/packing/silhouettes.ts; `imagePath` optionally points at an uploaded
// photo of the bag. Capacity is volume (litres) with an optional weight cap.
model PackingBag {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  volumeLiters Float
  maxWeightKg  Float?
  silhouette   String   @default("duffel")
  imagePath    String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// A packing plan for a trip (SmartPakker). Climate is fetched from the
// destination + dates and summarised into `climateData`. `assignments` holds
// the current per-bag item layout the algorithm produced (and the user edited).
model PackingTrip {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  /// What the user picked, or typed: "Seoul, South Korea". Display only.
  destination     String
  startDate       DateTime
  endDate         DateTime
  /// Resolved coordinates from the city picker (lib/services/geocode.ts).
  ///
  /// Storing these is what stops the weather lookup re-geocoding the
  /// destination string on every refresh — a search that is ambiguous by
  /// nature and can silently start resolving somewhere else. Null on trips
  /// created before the picker, and on any destination typed free-hand; the
  /// lookup falls back to searching the string, exactly as it always did.
  latitude        Float?
  longitude       Float?
  /// ISO 3166-1 alpha-2, e.g. "KR". Highlights the country on the trip map.
  countryCode     String?
  /// IANA zone, e.g. "Asia/Seoul". Used to show the destination's local time.
  timezone        String?
  climateData     String? // JSON: ClimateSummary from lib/services/weather.ts
  bagIds          String   @default("[]") // JSON: string[] of PackingBag ids
  /// JSON: TripRequirements from lib/packing/requirements.ts — what the trip is
  /// FOR (activities, laundry). Without it every trip to the same place in the
  /// same week packs identically; see that module's header.
  requirements    String?
  assignments     String   @default("{}") // JSON: { [bagId]: string[] of WardrobeItem ids }
  /// JSON: { [bagId]: string[] of PackingGear ids }. Kept apart from
  /// `assignments` rather than mixed in, because the packing algorithm reasons
  /// about garments — it counts tops against days and scores warmth — and a
  /// toothbrush answers none of those questions. Both maps feed the same
  /// volume and weight meters; only this one is off-limits to the planner.
  gearAssignments String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// A non-garment thing you put in a bag: charger, passport, contact lens
// solution. Deliberately a per-user library rather than per-trip rows — the
// same charger goes on every trip, and re-typing it each time is the reason
// people keep packing lists in Notes instead of here. A trip references these
// by id through `PackingTrip.gearAssignments`.
//
// Weight and volume are optional and nullable, NOT zero-defaulted: an unknown
// weight must not quietly read as "weighs nothing" in a bag meter. See
// lib/packing/gear.ts, which supplies a per-category fallback and marks the
// number as an estimate wherever it's shown.
model PackingGear {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// GearCategory from lib/packing/gear.ts. Drives the icon and the fallbacks.
  category     String    @default("misc")
  /// Icon name from components/icons.tsx ICON_REGISTRY, when the user has
  /// picked one. Null means "use the category's icon".
  icon         String?
  quantity     Int       @default(1)
  /// Per unit, not per line — the row's total is quantity × this.
  weightGrams  Int?
  volumeLiters Float?
  notes        String?
  /// Gear you take every time. Powers one-tap "add my essentials" on a trip.
  essential    Boolean   @default(false)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// ── Outfit intelligence (docs/OUTFIT_INTELLIGENCE.md) ────────────────────────

// One occasion of wearing one or more items. This is the foundation of the
// recommendation system: every model downstream is a function of the wear
// *sequence*, and a scalar counter is a lossy projection of a sequence that
// cannot be recovered after the fact.
//
// Wears are not booleans. Camera-roll inference emits low-confidence rows that
// the user can later confirm (confidence → 1, `confirmedAt` set), so anything
// aggregating this table must weight by `confidence` rather than count rows.
model WearEvent {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Day-grained on purpose: nobody knows what hour they put a coat on, and a
  /// false precision here would leak into the recurrence model in §6.
  wornOn   DateTime        @db.Date
  /// A join table rather than the JSON-array convention used by Outfit.itemIds.
  /// Per-item history is the hottest read in the system — every rollup, every
  /// dormancy score, every recurrence gap walks it — and a JSON string can only
  /// be searched with an unindexed LIKE. The schema note at the top of this file
  /// already flags JSON columns as a SQLite holdover to be undone; this is a
  /// table new enough to just start correct.
  items    WearEventItem[]
  outfitId String?

  /// WearSource in lib/wear/signals.ts — "explicit" | "photo" | "packing" | "backfill".
  source      String
  confidence  Float     @default(1)
  confirmedAt DateTime?

  // Context. The reason this table exists rather than a counter: "what should I
  // wear" is an inherently conditional question, and without context you can
  // only ever learn an unconditional preference.
  tempHighC   Float?
  climateBand String? // ClimateBand from lib/services/weather.ts
  precipMm    Float?
  occasion    String? // Occasion in lib/wear/occasions.ts
  /// Owner id from the stylePrefs roster. Wears do NOT cross-train affinity
  /// between household members — B wearing a coat says nothing about A's taste.
  wearerId    String?
  placeLabel  String?

  createdAt DateTime @default(now())

  @@index([userId, wornOn])
  @@index([userId, source])
  @@index([outfitId])
}

// Which items were worn on one occasion. The pair is also the set-level record:
// grouping by wearEventId gives "these were worn together", which is what
// compatibility learns from, while the itemId index gives per-item history.
model WearEventItem {
  wearEventId String
  wearEvent   WearEvent    @relation(fields: [wearEventId], references: [id], onDelete: Cascade)
  itemId      String
  item        WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([wearEventId, itemId])
  @@index([itemId])
}

// A user *choice* about a suggestion, as opposed to a behaviour. Kept separate
// from WearEvent because these are contrastive — a reroll means "this one, not
// that one, under identical context", which is the input a Bradley-Terry model
// wants and is worth several times its weight in wear counts.
//
// `policyId`/`propensity` exist from day one so a future ranker can be scored
// against logged data (IPS/SNIPS) instead of needing a live A/B test. They cost
// one column each now and are impossible to reconstruct later.
model PreferenceEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// PreferenceKind in lib/wear/signals.ts.
  kind        String
  /// JSON: string[] — the items the choice was *about*.
  itemIds     String
  /// JSON: string[] — for contrastive kinds, what was passed over. Empty otherwise.
  ///
  /// A deduplicated *union* across the passed-over outfits, so which piece
  /// belonged to which rival is not recoverable from it. Superseded by `armsJson`
  /// and kept for the rows written before that existed.
  rejectedIds String  @default("[]")
  contextJson String?

  /// JSON: string[][] — every outfit shown, in display order, one entry each.
  ///
  /// A tap on one of n outfits expresses n−1 pairwise preferences; the pooled
  /// `rejectedIds` above could only express one, so at the eight-outfit setting
  /// roughly six sevenths of what the user said was being discarded at write
  /// time. It also made the loser side structurally lopsided — five items
  /// against the winner's three once two arms shared a piece — which let a model
  /// fit composition noise as if it were taste.
  ///
  /// Null on rows written before this landed. Those cannot be un-pooled, so
  /// readers must handle both shapes; lib/wear/signals.ts owns that fallback.
  armsJson  String?
  /// Index into `armsJson` of the outfit that was chosen. Null for unary kinds
  /// (a like/pass names no winner among alternatives) and for older rows.
  chosenArm Int?

  policyId   String?
  propensity Float?

  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@index([userId, createdAt])
}

// Cached image embedding for one item.
//
// Deliberately NOT pgvector: inference and scoring both run on-device, so the
// server never computes a similarity — it is a sync store that keeps a second
// device from re-embedding the whole closet. Raw little-endian Float32 bytes
// (512 dims → 2 KB) needs no extension and no docker-compose change. If a
// server-side similarity need ever appears, adding pgvector is its own
// migration rather than a dependency taken on speculatively.
model ItemEmbedding {
  itemId    String       @id
  item      WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vector    Bytes
  dims      Int          @default(512)
  /// Encoder identity, e.g. "mobileclip-s2-int8" — rows are invalidated when
  /// this changes, since vectors from different encoders are not comparable.
  model     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([model])
}

// A one-off styling tip in the user's own words, captured against the outfit
// that was on screen — "don't put that hat with that shirt".
//
// The note text is kept verbatim alongside the parsed rules so the UI can show
// *why* a rule exists in the words the user chose, and so notes can be
// re-parsed if the parser improves without asking anyone to retype anything.
//
// `subjectIds` is what makes demonstratives tractable: because we know which
// garments were visible, "that hat" resolves to an id without pronoun
// resolution. It is also the allow-list the parser's output is validated
// against — a rule naming anything else is discarded.
model StyleNote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Exactly what the user typed.
  text       String
  /// How the note's garment references are resolved.
  ///   "outfit" — written about a specific on-screen proposal; `subjectIds`
  ///              holds exactly those garments and is the allow-list forever.
  ///   "closet" — written in the general tip box with nothing on screen, so it
  ///              resolves against the whole wardrobe. `subjectIds` is empty and
  ///              validation runs against the *current* closet instead, which
  ///              means a rule naming a deleted garment drops out on its own.
  scope      String  @default("outfit")
  /// JSON: string[] of WardrobeItem ids visible when it was written. Empty for
  /// closet-scoped notes.
  subjectIds String
  /// JSON: StyleRule[] from lib/outfit/style-rules.ts. Empty when the note
  /// didn't resolve to anything actionable — kept anyway, since the text is
  /// still a record of intent and may parse later.
  rules      String  @default("[]")
  /// Plain-language restatement shown back for confirmation.
  summary    String?
  /// "ai" | "keywords" — how the rules were derived.
  source     String  @default("keywords")

  /// Cleared to switch a note off without deleting what the user wrote.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, active])
}
