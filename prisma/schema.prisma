generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE on JSON columns:
// Structured fields (colors, styleTags, season, stylePrefs, sourceData) are
// stored as JSON-encoded strings (TEXT), a holdover from the original SQLite
// datasource. Use the helpers in lib/json.ts to read/write them so the
// encoding stays consistent. Converting them to native `Json` columns is a
// planned follow-up: it changes encode()'s contract at every write site, so
// it gets its own migration + PR rather than riding along with the engine
// switch.

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String?
  emailVerified     DateTime?         // NextAuth adapter field
  image             String?           // NextAuth adapter field (avatar URL)
  stylePrefs        String?           // JSON: { sizes?, favoriteColors?: string[], styles?: string[] }
  credits           Int               @default(0) // ghost-mannequin generations
  autoGenerateGhost Boolean           @default(false)
  createdAt         DateTime          @default(now())
  items             WardrobeItem[]
  tryOns            TryOnGeneration[]
  personPhotos      PersonPhoto[]
  outfits           Outfit[]
  outfitLayouts     OutfitLayout[]
  virtualTryOns     VirtualTryOn[]
  saleListings      SaleListing[]
  packingBags       PackingBag[]
  packingTrips      PackingTrip[]
  accounts          Account[]
  sessions          Session[]
  generationJobs    GenerationJob[]
  creditPurchases   CreditPurchase[]
  budgets           Budget[]
  shareLinks        ShareLink[]
}

// An unlisted public link to one item, one outfit, or the wishlist.
//
// The token is the only credential, so it must be long and random — see
// lib/share/token.ts. Links never expire but can be revoked at any time;
// `revokedAt` is kept rather than deleting the row so a revoked URL keeps
// resolving to a clear "this link was turned off" page instead of a 404 that
// looks like a bug.
//
// Only ever exposes derived data: the *thumbnail* of an item (never the
// full-resolution original) plus name, brand and colours.
model ShareLink {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  /// "item" | "outfit" | "wishlist" — see lib/share/kinds.ts
  kind      String
  /// WardrobeItem or Outfit id. Null for the wishlist, which is per-user.
  targetId  String?
  /// Optional note shown on the public page, e.g. "my birthday list".
  note      String?
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, kind])
}

// A pot of money earmarked for wishlist buying (e.g. "Grandma fund"). Wishlist
// items attach to a budget; purchased ones draw it down. When fundedBySales is
// on, proceeds from SaleListings marked sold top the pot back up, so clearing
// out the closet visibly grows the number you have to spend.
model Budget {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  amountCents   Int
  currency      String         @default("USD")
  fundedBySales Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         WardrobeItem[]

  @@index([userId])
}

// A completed Stripe Checkout purchase of a credit pack. The unique
// stripeSessionId makes webhook delivery idempotent: replays hit the
// constraint and are ignored instead of double-granting credits.
model CreditPurchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId String   @unique
  packId          String
  credits         Int
  amountCents     Int
  currency        String   @default("usd")
  createdAt       DateTime @default(now())

  @@index([userId])
}

// Background generation job. Generation (esp. multi-garment virtual try-on,
// which chains one provider call per garment) is too slow to run inside a
// request on serverless hosts, so it's queued here and executed by a worker
// (scripts/worker.ts). The UI enqueues, then polls status.
//   type:   "virtual_tryon" (more later)
//   status: "queued" | "running" | "succeeded" | "failed"
//   payload/result: JSON-encoded (see lib/jobs/*)
model GenerationJob {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  status      String    @default("queued")
  payload     String
  result      String?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

// --- NextAuth (Auth.js) adapter models -------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WardrobeItem {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  brand             String?
  category          String
  subcategory       String?
  colors            String            // JSON: { hex, name }[]
  priceCents        Int?
  currency          String            @default("USD")
  retailer          String?
  productUrl        String?
  material          String?
  pattern           String?
  styleTags         String            // JSON: string[]
  season            String            // JSON: string[]
  owners            String            @default("[]") // JSON: string[] of owner ids (see stylePrefs.owners roster)
  dHash             String?           // perceptual hash of the garment image (duplicate detection); computed lazily
  originalImagePath String
  originalThumbZoom Float             @default(1)     // zoom applied when framing the original in square tiles
  originalMirror    Boolean           @default(false)
  ghostImagePath    String?
  ghostViews        String?           // JSON: { label: string; imagePath: string }[]
  extraImagePaths   String?           // JSON: string[] — extra context shots
  isWishlist        Boolean           @default(false)
  // Wishlist budgeting. `budgetId` is the pot this item draws from;
  // `wishlistPriority` is 0 = must have, 1 = want, 2 = someday (see
  // lib/wishlist/priority.ts). Once bought, isWishlist flips false and
  // purchasedAt/purchasedCents record the actual draw-down — priceCents stays
  // the retail sticker so cost tracking and resale estimates still anchor to it.
  budgetId          String?
  budget            Budget?           @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  wishlistPriority  Int               @default(1)
  purchasedAt       DateTime?
  purchasedCents    Int?
  priceHistory      String?           // JSON: { cents: number; at: string }[] — oldest first
  priceCheckedAt    DateTime?
  timesWorn         Int               @default(0)
  lastWornAt        DateTime?
  // Packing estimates (SmartPakker). Null = derive from the heuristic table in
  // lib/packing/estimate.ts; populated = manual or (future) AI override.
  weightGrams       Int?
  volumeLiters      Float?
  notes             String?
  sourceData        String?           // JSON: raw stub/API response for debugging
  createdAt         DateTime          @default(now())
  tryOns            TryOnGeneration[]
  saleListing       SaleListing?

  @@index([userId])
  @@index([userId, category])
  @@index([userId, isWishlist])
  @@index([budgetId])
}

model TryOnGeneration {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  item            WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  resultImagePath String
  creditsUsed     Int          @default(1)
  createdAt       DateTime     @default(now())

  @@index([userId])
  @@index([itemId])
}

// A reference photo of the user (face / body) used as the subject for
// virtual try-on. Up to ~5 are kept active at a time but the model itself
// imposes no hard cap; the UI does.
model PersonPhoto {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  imagePath     String
  label         String?
  createdAt     DateTime       @default(now())
  virtualTryOns VirtualTryOn[]

  @@index([userId])
}

// A saved combination of WardrobeItem ids the user can try on as a unit.
model Outfit {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  itemIds       String         // JSON: string[] of WardrobeItem ids
  createdAt     DateTime       @default(now())
  virtualTryOns VirtualTryOn[]

  @@index([userId])
}

// One virtual try-on generation: a person photo + a set of garment items
// (optionally a saved Outfit) → a generated image.
model VirtualTryOn {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  personPhotoId   String
  personPhoto     PersonPhoto @relation(fields: [personPhotoId], references: [id], onDelete: Cascade)
  outfitId        String?
  outfit          Outfit?     @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  itemIds         String      // JSON: string[] of WardrobeItem ids
  prompt          String?
  resultImagePath String
  creditsUsed     Int         @default(1)
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([personPhotoId])
}

// Result of triaging a wardrobe item in the swipe-to-sell deck. One row per
// item the user has made a decision on. Marketplaces don't expose public
// listing APIs, so this tracks intent + a generated draft the user copies into
// Depop/Poshmark/etc. manually.
//   status: "skipped" (keep) | "for_sale" | "listed" | "sold"
model SaleListing {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId       String       @unique
  item         WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status       String       @default("for_sale")
  askingCents  Int?
  soldPriceCents Int?       // actual sale proceeds, recorded when marked sold
  currency     String       @default("USD")
  condition    String?      // "new_with_tags" | "like_new" | "good" | "fair"
  title        String?
  description  String?
  marketplaces String       @default("[]") // JSON: string[] of marketplace ids
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// Saved drag/resize/layer outfit compositions for the outfit-builder canvas.
model OutfitLayout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  frameHeight Int
  pieces      String   // JSON: { id, itemId, x, y, scale, z }[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// A piece of luggage the user owns (SmartPakker). `silhouette` is a preset id
// from lib/packing/silhouettes.ts; `imagePath` optionally points at an uploaded
// photo of the bag. Capacity is volume (litres) with an optional weight cap.
model PackingBag {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  volumeLiters Float
  maxWeightKg  Float?
  silhouette   String   @default("duffel")
  imagePath    String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// A packing plan for a trip (SmartPakker). Climate is fetched from the
// destination + dates and summarised into `climateData`. `assignments` holds
// the current per-bag item layout the algorithm produced (and the user edited).
model PackingTrip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  destination String
  startDate   DateTime
  endDate     DateTime
  climateData String?  // JSON: ClimateSummary from lib/services/weather.ts
  bagIds      String   @default("[]") // JSON: string[] of PackingBag ids
  assignments String   @default("{}") // JSON: { [bagId]: string[] of WardrobeItem ids }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
