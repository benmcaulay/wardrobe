{
  "name": "wardrobe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/fetch-embedding-model.ts && next build",
    "embedding:fetch": "tsx scripts/fetch-embedding-model.ts",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fal": "node --env-file=.env --import tsx scripts/test-fal.ts",
    "ghost:bakeoff": "node --env-file=.env --import tsx scripts/ghost-bakeoff.ts",
    "test:s3": "tsx scripts/verify-s3.ts",
    "test:jobs": "tsx scripts/verify-jobs.ts",
    "test:embedding": "tsx scripts/verify-embedding.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:backfill-wears": "tsx --env-file=.env scripts/backfill-wear-events.ts",
    "db:migrate-from-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "mac-photos:scan": "tsx --env-file=.env scripts/mac-photos-scan.ts",
    "test:stripe": "tsx scripts/verify-stripe.ts",
    "benchmark:wear-retrieval": "tsx --env-file=.env scripts/benchmark-wear-retrieval.ts",
    "calibrate:wear-match": "tsx --env-file=.env scripts/calibrate-wear-match.ts",
    "benchmark:style-text": "tsx --env-file=.env scripts/benchmark-style-text.ts",
    "eval:ranker": "tsx --env-file=.env scripts/eval-ranker.ts",
    "eval:catalog": "tsx --env-file=.env scripts/eval-catalog.ts",
    "audit:layout": "tsx --env-file=.env scripts/audit-layout.ts",
    "map:build": "tsx scripts/build-world-map.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "is-generator-function": "1.0.10"
    }
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.2",
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@fal-ai/client": "^1.10.0",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.55.2",
    "adm-zip": "^0.5.17",
    "archiver": "5.3.2",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "14.2.18",
    "next-auth": "4.24.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "sharp": "^0.33.5",
    "stripe": "^22.2.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "6.0.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "s3rver": "^3.7.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.33.0"
}
